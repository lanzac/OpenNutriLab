msgid "Please enter a barcode."
msgstr "Veuillez entrer un code-barres."

#, python-format
msgid ""
"Barcode %(barcode)s was not found in OpenFoodFacts. Please fill in the "
"details by hand."
msgstr ""
"Le code-barres %(barcode)s est introuvable dans OpenFoodFacts. Veuillez "
"saisir les informations à la main."

#, python-format
msgid ""
"OpenFoodFacts could not be reached for barcode %(barcode)s. Please try "
"again, or fill in the details by hand."
msgstr ""
"OpenFoodFacts n'a pas pu être joint pour le code-barres %(barcode)s. "
"Veuillez réessayer, ou saisir les informations à la main."

#, python-format
msgid ""
"Product %(barcode)s was saved, but its photo could not be downloaded from "
"OpenFoodFacts. Please try again, or upload one by hand."
msgstr ""
"Le produit %(barcode)s a été enregistré, mais sa photo n'a pas pu être "
"téléchargée depuis OpenFoodFacts. Veuillez réessayer, ou en téléverser une à "
"la main."

