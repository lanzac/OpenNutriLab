// For format details, see https://containers.dev/implementors/json_reference/
{
    "name": "opennutrilab_dev",
    "dockerComposeFile": [
        "../docker-compose.local.yml"
    ],
    "init": true,
    // Tells devcontainer.json supporting services / tools whether they should run
    // /bin/sh -c "while sleep 1000; do :; done" when starting the container instead of the container’s default command
    "overrideCommand": false,
    "service": "django",
    "remoteEnv": {
        "PATH": "/home/dev-user/.local/bin:${containerEnv:PATH}",
        // Point Claude Code's whole config home at the persisted volume. By default
        // .claude.json sits next to ~/.claude, in the container's writable layer, and
        // is lost on rebuild; this pulls it inside the volume with the credentials
        // and session transcripts.
        "CLAUDE_CONFIG_DIR": "/home/dev-user/.claude"
    },
    "remoteUser": "dev-user",
    "workspaceFolder": "/app",
    // Set *default* container specific settings.json values on container create.
    "customizations": {
        "vscode": {
            "settings": {
                "editor.formatOnSave": true,
                // Set the global interpreter for the project
                "python.defaultInterpreterPath": "/app/.venv/bin/python",
                // Ruff configuration (system binary)
                "ruff.path": [
                    "/usr/local/bin/ruff"
                ],
                "ruff.importStrategy": "fromEnvironment",
                // Basedpyright configuration (system binary)
                "basedpyright.importStrategy": "fromEnvironment",
                "basedpyright.executablePath": "/usr/local/bin/basedpyright",
                "python.analysis.typeCheckingMode": "off", // Handled by basedpyright
                // djLint configuration (system binary)
                "djlint.executablePath": "/usr/local/bin/djlint",
                "[python]": {
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "always"
                    },
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },
                "[html]": {
                    "editor.defaultFormatter": "monosans.djlint"
                },
                // Disable old flags that slow down initialization
                "python.linting.enabled": false,
                "python.linting.pyrightEnabled": false
            },
            // https://code.visualstudio.com/docs/remote/devcontainerjson-reference#_vs-code-specific-properties
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "davidanson.vscode-markdownlint",
                "mrmlnc.vscode-duplicate",
                "ms-python.python",
                "charliermarsh.ruff",
                "detachhead.basedpyright",
                "batisteo.vscode-django",
                "actboy168.tasks",
                "ms-ossdata.vscode-pgsql",
                "waderyan.gitblame",
                "monosans.djlint",
                "vivaxy.vscode-conventional-commits",
                "syntaf.vscode-pytest-runner",
                "mikestead.dotenv",
                "anthropic.claude-code",
                "usernamehw.errorlens",
                "donjayamanne.githistory",
                "eamodio.gitlens",
                "yzhang.markdown-all-in-one",
                "zakhariimelnyk.claude-git-commit",
                // GUI for act: run/inspect .github/workflows jobs locally. See
                // https://sanjulaganepola.github.io/github-local-actions-docs/
                "sanjulaganepola.github-local-actions"
            ]
        }
    },
    // Uncomment the next line if you want start specific services in your Docker Compose config.
    // "runServices": [],
    // Uncomment the next line if you want to keep your containers running after VS Code shuts down.
    // "shutdownAction": "none",
    // Uncomment the next line to run commands after the container is created.
    "postCreateCommand": {
        "installPythonTools": "UV_TOOL_BIN_DIR=$HOME/.local/bin uv tool install --python 3.13 graphifyy && $HOME/.local/bin/graphify install",
        "setupShell": "cat .devcontainer/bashrc.override.sh >> ~/.bashrc && pre-commit install-hooks",
        // The playwright package is a dev dependency, but the browser it drives
        // is not: it is a ~115 MB download into ~/.cache/ms-playwright, which
        // compose keeps on a named volume, so this is a no-op after the first
        // time. uv sync first because /app/.venv is itself a named volume and
        // can outlive the image that filled it. The two playwright steps cannot
        // be merged into `install --with-deps`: the apt packages need root,
        // while the browser must land in dev-user's cache, not root's.
        "installBrowsers": "uv sync --frozen && sudo .venv/bin/python -m playwright install-deps chromium && .venv/bin/python -m playwright install chromium"
    },
    // The mounted host docker.sock belongs to the host's docker group, whose
    // gid varies per host and isn't known at image build time, so dev-user
    // can't be added to it ahead of time. Runs on every start (not just
    // create) since that gid can differ across hosts/rebuilds.
    "postStartCommand": "sudo chmod 666 /var/run/docker.sock"
}
