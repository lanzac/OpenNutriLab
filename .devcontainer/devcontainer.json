// For format details, see https://containers.dev/implementors/json_reference/
{
    "name": "opennutrilab_dev",
    "dockerComposeFile": [
        "../docker-compose.local.yml"
    ],
    "init": true,
    "mounts": [
        {
            "source": "./.devcontainer/bash_history",
            "target": "/home/dev-user/.bash_history",
            "type": "bind"
        }
    ],
    // Tells devcontainer.json supporting services / tools whether they should run
    // /bin/sh -c "while sleep 1000; do :; done" when starting the container instead of the container’s default command
    "overrideCommand": false,
    "service": "django",
    // "remoteEnv": {"PATH": "/home/dev-user/.local/bin:${containerEnv:PATH}"},
    "remoteUser": "dev-user",
    "workspaceFolder": "/app",
    // Set *default* container specific settings.json values on container create.
    "customizations": {
        "vscode": {
            "settings": {
                "editor.formatOnSave": true,
                // Set the global interpreter for the project
                "python.defaultInterpreterPath": "/app/.venv/bin/python",
                // Ruff configuration (system binary)
                "ruff.path": [
                    "/usr/local/bin/ruff"
                ],
                "ruff.importStrategy": "fromEnvironment",
                // Basedpyright configuration (system binary)
                "basedpyright.importStrategy": "fromEnvironment",
                "basedpyright.executablePath": "/usr/local/bin/basedpyright",
                "python.analysis.typeCheckingMode": "off", // Handled by basedpyright
                // djLint configuration (system binary)
                "djlint.executablePath": "/usr/local/bin/djlint",
                "[python]": {
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "always"
                    },
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },
                "[html]": {
                    "editor.defaultFormatter": "monosans.djlint"
                },
                // Disable old flags that slow down initialization
                "python.linting.enabled": false,
                "python.linting.pyrightEnabled": false
            },
            // https://code.visualstudio.com/docs/remote/devcontainerjson-reference#_vs-code-specific-properties
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "davidanson.vscode-markdownlint",
                "mrmlnc.vscode-duplicate",
                "ms-python.python",
                "charliermarsh.ruff",
                "detachhead.basedpyright",
                "batisteo.vscode-django",
                "actboy168.tasks",
                "ms-ossdata.vscode-pgsql",
                "waderyan.gitblame",
                "monosans.djlint",
                "vivaxy.vscode-conventional-commits",
                "syntaf.vscode-pytest-runner",
                "mikestead.dotenv",
                "anthropic.claude-code",
                "usernamehw.errorlens",
                "donjayamanne.githistory",
                "eamodio.gitlens",
                "yzhang.markdown-all-in-one",
                "zakhariimelnyk.claude-git-commit"
            ]
        }
    },
    // Uncomment the next line if you want start specific services in your Docker Compose config.
    // "runServices": [],
    // Uncomment the next line if you want to keep your containers running after VS Code shuts down.
    // "shutdownAction": "none",
    // Uncomment the next line to run commands after the container is created.
    "postCreateCommand": {
        "installPythonTools": "uv tool install --python 3.13 graphifyy && graphify install",
        "setupShell": "cat .devcontainer/bashrc.override.sh >> ~/.bashrc && pre-commit install-hooks"
    }
}
